rules_version = '2';
// Copiar para: Firebase Console → Firestore Database → Regras → Publicar
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'joana1589@gmail.com',
             'tonizito.alves92@gmail.com'
           ];
    }

    // Dados atuais: definições em producao/v2 e cada registo em producao/v2/<coleção>/<id>
    match /producao/v2 {
      allow read, write: if autorizado();

      // Histórico de movimentos: só se pode acrescentar — ninguém altera nem apaga
      match /historico/{id} {
        allow read, create: if autorizado();
        allow update, delete: if false;
      }

      match /{colecao}/{id} {
        allow read, write: if autorizado() && colecao != 'historico';
      }
    }

    // Documento antigo: só leitura (cópia de segurança)
    match /producao/dados_mestre {
      allow read: if autorizado();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
